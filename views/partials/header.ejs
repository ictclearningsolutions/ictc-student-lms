<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#1a4f8b">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" type="image/png" href="/icons/logo-192.png">
  <link rel="apple-touch-icon" href="/icons/logo-192.png">
  <title><%= title ? title + ' - ' : '' %>ICTC Student LMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% if (admin) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/admin/dashboard">
      <img src="/icons/logo-192.png" alt="ICTC">
      <span>ICTC Admin<small>Student Learning Portal</small></span>
    </a>
    <nav class="nav-links">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/students">Students</a>
      <a href="/admin/courses">Courses</a>
      <a href="/admin/logout">Logout</a>
    </nav>
  </div>
</header>
<% } else if (student) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/dashboard">
      <img src="/icons/logo-192.png" alt="ICTC">
      <span>ICTC LMS<small><%= student.full_name || student.student_id %></small></span>
    </a>
    <nav class="nav-links">
      <a href="/dashboard" class="<%= activeNav === 'dashboard' ? 'active' : '' %>">My Courses</a>
      <a href="/profile" class="<%= activeNav === 'profile' ? 'active' : '' %>">Profile</a>
      <a href="/logout">Logout</a>
    </nav>
  </div>
</header>
<% } %>
