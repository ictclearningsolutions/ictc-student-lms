<%- include('../partials/header', { title: 'Profile', activeNav: 'profile' }) %>
<div class="wrap">
  <h1 class="page-title">My Profile</h1>
  <% if (message) { %><div class="alert alert-green"><%= message %></div><% } %>
  <% if (error) { %><div class="alert alert-red"><%= error %></div><% } %>
  <% if (pwError) { %><div class="alert alert-red"><%= pwError %></div><% } %>
  <% if (pwOk) { %><div class="alert alert-green">Password changed successfully.</div><% } %>

  <div class="card" style="text-align:center;">
    <h3>Profile picture</h3>
    <div class="mt-2 mb-2" style="display:flex; justify-content:center;">
      <% if (student.avatar) { %>
      <img class="avatar-lg" src="<%= student.avatar %>" alt="Your profile picture">
      <% } else { %>
      <span class="avatar-lg" style="width:96px;height:96px;"><%= (student.full_name || student.student_id).charAt(0).toUpperCase() %></span>
      <% } %>
    </div>
    <form method="POST" action="/profile/avatar" enctype="multipart/form-data">
      <div class="form-row">
        <input type="file" name="avatar" accept="image/*" required>
      </div>
      <button type="submit" class="btn btn-sm">Upload new picture</button>
      <p class="form-hint">JPG, PNG or GIF &middot; max 2 MB</p>
    </form>
  </div>

  <div class="card">
    <div class="form-row">
      <label>Student ID</label>
      <input type="text" value="<%= student.student_id %>" disabled>
    </div>
    <form method="POST" action="/profile">
      <div class="form-row">
        <label for="full_name">Full name</label>
        <input type="text" id="full_name" name="full_name" value="<%= student.full_name || '' %>" placeholder="Your full name">
      </div>
      <div class="form-row">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= student.email || '' %>" placeholder="you@email.com">
      </div>
      <div class="form-row">
        <label for="mobile">Mobile</label>
        <input type="tel" id="mobile" name="mobile" value="<%= student.mobile || '' %>" placeholder="e.g. 9876543210">
      </div>
      <button type="submit" class="btn">Save profile</button>
    </form>
    <p class="muted small mt-2">Last login: <%= student.last_login || '—' %></p>
  </div>

  <div class="card">
    <h3>Change password</h3>
    <form method="POST" action="/profile/password">
      <div class="form-row">
        <label for="current_password">Current password</label>
        <input type="password" id="current_password" name="current_password" required autocomplete="current-password">
      </div>
      <div class="form-row">
        <label for="new_password">New password (min 6 characters)</label>
        <input type="password" id="new_password" name="new_password" required autocomplete="new-password">
      </div>
      <div class="form-row">
        <label for="confirm_password">Confirm new password</label>
        <input type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password">
      </div>
      <button type="submit" class="btn">Update password</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
