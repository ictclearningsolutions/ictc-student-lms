<%- include('../partials/header', { title: 'Result', activeNav: 'dashboard' }) %>
<div class="wrap">
  <div class="card" style="text-align:center; padding: 34px 18px;">
    <div style="width:76px;height:76px;border-radius:50%;margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:800;color:#fff;background:<%= passed ? 'var(--green)' : 'var(--primary)' %>;"><%= percentage %>%</div>
    <h1 class="page-title" style="margin-bottom:6px;"><%= passed ? 'Congratulations, you passed!' : 'Keep practicing!' %></h1>
    <p class="muted"><%= assessment.title %> &middot; <%= course.title %></p>

    <div class="progress-track mt-2" style="max-width:340px; margin:16px auto; height:14px;">
      <div class="progress-fill <%= passed ? 'done' : '' %>" style="width:<%= percentage %>%"></div>
    </div>

    <div class="flex" style="justify-content:center; gap:20px;">
      <div>
        <div class="stat-value" style="font-size:2.2rem;"><%= score %><span class="muted" style="font-size:1rem;">/<%= total %></span></div>
        <div class="stat-label">Correct</div>
      </div>
      <div>
        <div class="stat-value" style="font-size:2.2rem; color:<%= passed ? 'var(--green)' : 'var(--red)' %>;"><%= percentage %>%</div>
        <div class="stat-label">Score</div>
      </div>
      <div>
        <div class="stat-value" style="font-size:2.2rem; color:var(--muted);"><%= passing %>%</div>
        <div class="stat-label">Pass mark</div>
      </div>
    </div>

    <div class="flex mt-2" style="justify-content:center;">
      <a class="btn" href="/courses/<%= course.id %>">Back to course</a>
      <% if (!passed) { %>
      <a class="btn btn-green" href="/courses/<%= course.id %>/assessment/<%= index %>">Retry assessment</a>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
